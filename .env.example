# Uncommon CodeBloom — Frontend environment variables
# Copy this file to .env.local for local development.
# Never commit .env.local or secrets to source control.

# Local development only. In Vercel, set VITE_API_BASE_URL to the deployed
# ASP.NET Core API's publicly reachable HTTPS base URL in Project Settings >
# Environment Variables, then redeploy. Do not use localhost in production.
VITE_API_BASE_URL=http://localhost:5202

# Public Supabase configuration. Never use a service-role or Gemini key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: enable debug logging of API calls
VITE_DEBUG_API=false

# ------------------------------------------------------------------
# Firebase web configuration (optional; enables Google sign-in)
# ------------------------------------------------------------------
# Copy these values from the Firebase Console:
#   Project settings (gear icon) > General > Your apps > Web app.
# The Firebase web API key identifies the project and is safe to expose in a
# browser bundle. It is NOT the service-account key. Never put a service-account
# JSON file or private key in a VITE_* variable.
#
# Leave these blank to keep the existing username/password sign-in only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
